  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && npm run build:server",
    "build:server": "node build-server.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "test": "node build-tests.mjs && node --test \"test-build/**/*.test.js\" \"scripts/**/*.test.mjs\"",
    "package": "npm run build && tar -czf plugin-vigie-v$npm_package_version.tar.gz dist/ server/index.mjs plugin.json"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.62.0",
    "@tentacle-tv/plugins-api": "file:./types/plugins-api",
    "@types/node": "^25.3.3",
    "@types/react": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "^0.27.3",
    "fastify": "^5.12.5",
    "react": "^19.0.0",
    "react-i18next": "^16.5.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
